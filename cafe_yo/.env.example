# ─────────────────────────────────────────────
# Cafe Yo — Environment Variables Example
# ─────────────────────────────────────────────
# Copy this file to .env and adjust values.
#   cp .env.example .env
# ─────────────────────────────────────────────

# Connection Strings
ConnectionStrings__DefaultConnection=Server=(local);Database=CafeYoDB;Trusted_Connection=True;TrustServerCertificate=True;

# Payment Gateway — Bayar.gg
PaymentGateway__BayarGG__BaseUrl=https://www.bayar.gg
PaymentGateway__BayarGG__ApiKey=your-api-key-here
PaymentGateway__BayarGG__FixedFee=200
PaymentGateway__BayarGG__MaxExtraFee=5000
PaymentGateway__BayarGG__TimeoutSeconds=30

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft__AspNetCore=Warning

# Allowed Hosts
AllowedHosts=*