@{
    var pageTitle = ViewData["Title"] as string ?? "Home";
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var isAdmin = isAuthenticated && User.IsInRole("Admin");
    var isMember = isAuthenticated && User.IsInRole("Customer");
    var memberName = isAuthenticated ? (User.Identity?.Name ?? "Member") : "";
    var tableLocked = string.Equals(Context?.Request?.Cookies["nr_tableLocked"], "1", StringComparison.Ordinal);
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@pageTitle - CafeYo</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="site-root" data-member="@(isMember.ToString().ToLower())" data-member-name="@memberName">
    <header class="site-header">
        <div class="container site-header-inner d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2 site-brand-row">
                <div class="logo-icon">☕</div>
                <a class="navbar-brand site-brand" asp-page="/Index">CafeYo</a>
            </div>

            <div class="site-header-actions d-flex align-items-center gap-2">
                <a href="javascript:void(0)"
                   id="tableBadge"
                   class="nav-link table-pill me-2 @(tableLocked ? "pe-none opacity-75" : "")"
                   @(tableLocked ? "" : "data-bs-toggle=\"modal\" data-bs-target=\"#tableModal\"")
                   aria-label="Set table number">
                    <span class="table-pill-icon"><i class="bi bi-journal-text"></i></span>
                    <span class="text-white table-pill-label">Meja:</span>
                    <span id="tableBadgeValue" class="fw-semibold">-</span>
                </a>
                @if (isMember)
                {
                    <div class="dropdown">
                        <button class="member-pill dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i>
                            <span>@memberName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end member-menu">
                            <li><span class="dropdown-item-text">Akun Member</span></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" action="/Auth/Logout">
                                    <button class="dropdown-item" type="submit">Keluar</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                @if (!tableLocked)
                {
                    <button class="btn btn-outline-gold btn-sm" id="pickTableBtn" data-bs-toggle="modal" data-bs-target="#tableModal">Pilih Meja</button>
                }
                <a class="btn btn-gold btn-sm btn-order-now" href="/#menu">Pesan Sekarang</a>
            </div>
        </div>
    </header>

    <main class="main-content">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer py-4">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div class="site-footer-copy">© @DateTime.Now.Year CafeYo. Hak cipta dilindungi.</div>
            <div class="mt-2 mt-md-0 site-footer-links">
                <a href="/privacy" class="site-footer-link me-3">Privasi</a>
                <a href="javascript:void(0)" class="site-footer-link" data-bs-toggle="modal" data-bs-target="#contactInfoModal">Kontak</a>
                <a href="/staff" class="staff-area-link ms-3">Area Staf</a>
            </div>
        </div>
    </footer>

    @await Html.PartialAsync("_ChatbotWidget")

    <!-- Table selection modal -->
    <div class="modal fade table-modal" id="tableModal" tabindex="-1" aria-labelledby="tableModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content table-modal-content">
                <div class="modal-header border-0 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <div class="table-modal-icon">
                            <i class="bi bi-journal-text"></i>
                        </div>
                        <div>
                            <h5 class="modal-title mb-0" id="tableModalLabel">Nomor Meja</h5>
                            <small class="text-muted table-modal-subtitle">Simpan sekali untuk checkout lebih cepat.</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body pt-3">
                    <div class="table-modal-label mb-2">Pilih Meja</div>
                    <div class="table-modal-legend mb-2">
                        <span class="legend-item"><i class="legend-dot kosong"></i> Kosong</span>
                        <span class="legend-item"><i class="legend-dot booking"></i> Booking</span>
                        <span class="legend-item"><i class="legend-dot isi"></i> Isi</span>
                    </div>
                    <div id="tablePickerGrid" class="table-picker-grid"></div>
                    <div class="table-modal-hint mt-2" id="tablePickerHint">Pilih meja yang statusnya kosong.</div>
                    <input type="hidden" id="tableNumberInput" name="nr_table_number" />

                    <div class="mt-4">
                        <div class="table-modal-label mb-2">Status Keanggotaan</div>
                        <div class="btn-group w-100 table-modal-toggle" role="group" aria-label="Status Keanggotaan">
                            <input type="radio" class="btn-check" name="membershipStatus" id="membershipGuest" autocomplete="off" value="Guest" checked />
                            <label class="btn btn-outline-light" for="membershipGuest">Tamu</label>

                            <input type="radio" class="btn-check" name="membershipStatus" id="membershipMember" autocomplete="off" value="Member" />
                            <label class="btn btn-outline-light" for="membershipMember">Member</label>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0 d-flex justify-content-between">
                    <button type="button" class="btn table-modal-reset" id="tableResetBtn">Reset</button>
                    <button type="button" class="btn table-modal-save" id="tableSaveBtn">Booking Meja</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Membership auth modal -->
    <div class="modal fade auth-modal" id="authModal" tabindex="-1" aria-labelledby="authModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content auth-modal-content">
                <div class="modal-header border-0 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <div class="auth-modal-icon">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div>
                            <h5 class="modal-title mb-0" id="authModalLabel">Akses Member</h5>
                            <small class="text-muted auth-modal-subtitle" id="authModalSubtitle">Masuk atau daftar untuk lanjut sebagai member.</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body pt-3">
                    <div class="alert alert-danger d-none" id="authError" role="alert"></div>
                    <ul class="nav nav-pills auth-tabs mb-3" id="authTab" role="tablist">
                        <li class="nav-item w-50" role="presentation" id="authLoginTabWrap">
                            <button class="nav-link active w-100" id="login-tab" data-bs-toggle="tab" data-bs-target="#login-pane" type="button" role="tab" aria-controls="login-pane" aria-selected="true">Masuk</button>
                        </li>
                        <li class="nav-item w-50" role="presentation" id="authRegisterTabWrap">
                            <button class="nav-link w-100" id="register-tab" data-bs-toggle="tab" data-bs-target="#register-pane" type="button" role="tab" aria-controls="register-pane" aria-selected="false">Daftar</button>
                        </li>
                    </ul>

                    <div class="tab-content" id="authTabContent">
                        <div class="tab-pane fade show active" id="login-pane" role="tabpanel" aria-labelledby="login-tab" tabindex="0">
                            <div class="mb-3">
                                <label for="loginUsername" class="form-label auth-modal-label">Nama Pengguna</label>
                                <input type="text" class="form-control auth-modal-input" id="loginUsername" placeholder="" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" />
                                <div class="invalid-feedback">Nama pengguna wajib diisi.</div>
                            </div>
                            <div class="mb-2">
                                <label for="loginPassword" class="form-label auth-modal-label">Kata Sandi</label>
                                <div class="input-group auth-password-group">
                                    <input type="password" class="form-control auth-modal-input" id="loginPassword" placeholder="Masukkan kata sandi" autocomplete="new-password" />
                                    <button type="button" class="btn auth-password-toggle" id="loginPasswordToggle" aria-label="Tampilkan password" aria-pressed="false">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <div class="invalid-feedback">Kata sandi wajib diisi.</div>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="register-pane" role="tabpanel" aria-labelledby="register-tab" tabindex="0">
                            <div class="mb-3">
                                <label for="regName" class="form-label auth-modal-label">Nama Lengkap</label>
                                <input type="text" class="form-control auth-modal-input" id="regName" placeholder="Nama kamu" />
                                <div class="invalid-feedback">Nama wajib diisi.</div>
                            </div>
                            <div class="mb-3">
                                <label for="regUsername" class="form-label auth-modal-label">Nama Pengguna</label>
                                <input type="text" class="form-control auth-modal-input" id="regUsername" placeholder="Nama pengguna" />
                                <div class="invalid-feedback">Nama pengguna wajib diisi.</div>
                            </div>
                            <div class="mb-2">
                                <label for="regPassword" class="form-label auth-modal-label">Kata Sandi</label>
                                <div class="input-group auth-password-group">
                                    <input type="password" class="form-control auth-modal-input" id="regPassword" placeholder="Buat kata sandi" />
                                    <button type="button" class="btn auth-password-toggle" id="regPasswordToggle" aria-label="Tampilkan password" aria-pressed="false">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <div class="invalid-feedback">Kata sandi wajib diisi.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0 d-flex justify-content-end gap-2">
                    <button type="button" class="btn auth-modal-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="button" class="btn auth-modal-primary" id="authContinueBtn">Lanjut</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Customer table alert -->
    <div class="modal fade alert-modal" id="tableReadyModal" tabindex="-1" aria-labelledby="tableReadyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content alert-modal-content">
                <div class="modal-header border-0 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <div class="alert-modal-icon">
                            <i class="bi bi-bell-fill"></i>
                        </div>
                        <div>
                            <h5 class="modal-title mb-0" id="tableReadyModalLabel">Pesanan Siap</h5>
                            <small class="text-muted">Panggilan dari kasir untuk meja kamu.</small>
                        </div>
                    </div>
                </div>
                <div class="modal-body pt-3">
                    <div class="table-alert-title">Meja <span id="tableReadyNumber">-</span></div>
                    <div class="table-alert-message" id="tableReadyMessage">Pesanan Anda sudah siap.</div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn table-alert-stop w-100" id="stopTableAlertBtn" data-bs-dismiss="modal">Saya Tahu, Matikan Alarm</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="contactInfoModal" tabindex="-1" aria-labelledby="contactInfoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content table-modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title" id="contactInfoModalLabel">Kontak CafeYo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-2">
                    <p class="mb-2">Email: <a class="site-footer-link" href="mailto:riorizqi918@gmail.com">riorizqi918@gmail.com</a></p>
                    <p class="mb-0">WhatsApp: <a class="site-footer-link" href="https://wa.me/6285810383881" target="_blank" rel="noopener noreferrer">6285810383881</a></p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn table-modal-save" data-bs-dismiss="modal">Tutup</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
