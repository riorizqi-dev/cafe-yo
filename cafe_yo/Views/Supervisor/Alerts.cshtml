@{ Layout = "~/Views/Shared/_LayoutAdmin.cshtml"; ViewData["Title"] = "Alert Operasional"; }
<style>.sv{background:#0c131b;color:#e9f0f7;border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:1rem}.sv h1{font-size:1.35rem;margin:0 0 .75rem}.sv a{color:#9cc9ff}.p{max-height:72vh;overflow:auto}.c{color:#9aabbe;font-size:.78rem;text-transform:uppercase;margin:.75rem 0 .35rem}.i{border:1px solid rgba(255,255,255,.09);border-left:3px solid #d3ac55;background:#15202b;border-radius:10px;padding:.55rem .65rem;margin-bottom:.45rem}.i.d{border-left-color:#ce6666}</style>
<section class="sv"><h1>Alert Operasional</h1><p><a href="/Supervisor"><- Kembali ke Hub</a></p><div id="alerts" class="p">Memuat...</div></section>
@section Scripts{<script>
document.addEventListener('DOMContentLoaded',()=>{const p=document.getElementById('alerts');const cat=t=>t?.includes('stock')?'Stok':t?.includes('cancel')?'Pembatalan':'Pesanan';const run=async()=>{const r=await fetch('/api/supervisor/operational-alerts',{cache:'no-store'});if(!r.ok)return;const d=await r.json();const rows=Array.isArray(d?.alerts)?d.alerts:[];if(!rows.length){p.innerHTML='Belum ada alert.';return;}const g={};rows.forEach(x=>{const k=cat(x.type||'');(g[k]||(g[k]=[])).push(x);});p.innerHTML=Object.entries(g).map(([k,v])=>`<div><div class="c">${k}</div>${v.map(a=>`<div class="i ${(a.severity||'').toLowerCase()==='danger'?'d':''}"><strong>${a.title}</strong><div>${a.message}</div></div>`).join('')}</div>`).join('');};run();setInterval(run,5000);});
</script>}
