@{ Layout = "~/Views/Shared/_LayoutAdmin.cshtml"; ViewData["Title"] = "Resep"; }
<style>*{box-sizing:border-box}.sv{background:#0b1220;color:#fff;border:1px solid #1f3351;border-radius:16px;padding:1rem}.top{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem}.btn{background:#f6d44d;color:#111;border:0;border-radius:10px;padding:.55rem .85rem;font-weight:700}.btn2{background:#13233a;color:#fff;border:1px solid #2c466d;border-radius:10px;padding:.5rem .75rem}.row{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-top:.8rem}.card{background:#0f1a2d;border:1px solid #233a5d;border-radius:12px;padding:.75rem}select,input{width:100%;background:#091525;color:#fff;border:1px solid #2f4b74;border-radius:10px;padding:.5rem}.muted{color:#fff}.act{display:flex;gap:.35rem;flex-wrap:wrap}.b{padding:.08rem .45rem;border-radius:999px;font-size:.72rem}.ok{background:#1e7a48}.no{background:#8a2a3a}h1,h2,h3,p,div,span,label,strong{color:#fff}@@media(max-width:960px){.row{grid-template-columns:1fr}}</style>
<section class='sv'><div class='top'><h1 style='margin:0'>Resep / Komposisi Menu</h1><div><button class='btn2' onclick="location.href='/Supervisor'">Kembali</button> <button class='btn' id='toggleForm'>Tambah Komposisi</button></div></div><div class='row'><div class='card' id='formWrap' style='display:none'><h3 id='formTitle' style='margin:.1rem 0 .5rem'>Tambah Komposisi</h3><select id='menu'></select><select id='ingredient' style='margin-top:.45rem'></select><input id='qty' type='number' step='0.001' placeholder='Jumlah per pesanan' style='margin-top:.45rem'><div class='act' style='margin-top:.55rem'><button class='btn' id='save'>Simpan</button><button class='btn2' id='reset'>Reset</button></div><input type='hidden' id='editId' value='0'></div><div class='card'><h3 style='margin:.1rem 0 .5rem'>Daftar Komposisi</h3><div id='list'>Memuat...</div></div></div></section>
@section Scripts{<script>document.addEventListener('DOMContentLoaded',()=>{const g=id=>document.getElementById(id),list=g('list');const esc=s=>String(s??'').replaceAll('<','&lt;');const reset=()=>{g('editId').value='0';g('qty').value='';g('formTitle').textContent='Tambah Komposisi';g('formWrap').style.display='none';};window.pickRecipe=(id,qty)=>{g('editId').value=id;g('qty').value=qty;g('formTitle').textContent='Edit Komposisi #'+id;g('formWrap').style.display='block';};window.delRecipe=async(id)=>{if(!confirm('Hapus komposisi ini?'))return;const r=await fetch('/api/supervisor/menu-recipes/'+id,{method:'DELETE'});if(!r.ok){alert('Gagal hapus');return;}loadRecipes();};async function loadOptions(){const [m,i]=await Promise.all([fetch('/api/supervisor/menu-options',{cache:'no-store'}),fetch('/api/supervisor/ingredients/all',{cache:'no-store'})]);if(m.ok){const d=await m.json();const rows=Array.isArray(d?.menuItems)?d.menuItems:[];g('menu').innerHTML=rows.map(x=>`<option value='${x.menuItemId}'>${esc(x.name)}</option>`).join('');}if(i.ok){const d=await i.json();const rows=(Array.isArray(d?.ingredients)?d.ingredients:[]).filter(x=>x.isActive);g('ingredient').innerHTML=rows.map(x=>`<option value='${x.stockItemId}'>${esc(x.name)} (${esc(x.unit)})</option>`).join('');}}async function loadRecipes(){const r=await fetch('/api/supervisor/menu-recipes',{cache:'no-store'});if(!r.ok)return;const d=await r.json();const rows=Array.isArray(d?.recipes)?d.recipes:[];list.innerHTML=rows.map(x=>`<div style='padding:.5rem 0;border-bottom:1px solid #223754'><div style='display:flex;justify-content:space-between'><strong>${esc(x.menuName)}</strong><span class='b ${x.canSell?'ok':'no'}'>${x.canSell?'Bisa Dijual':'Tidak Bisa Dijual'}</span></div><div class='muted'>${(x.ingredients||[]).map(i=>`#${i.menuIngredientId} ${esc(i.ingredientName)}: ${i.quantityNeeded} ${esc(i.unit)} (stok ${i.currentStock}) <span class='act'><button class='btn2' onclick='pickRecipe(${i.menuIngredientId},${i.quantityNeeded})'>Edit</button><button class='btn2' onclick='delRecipe(${i.menuIngredientId})'>Hapus</button></span>`).join('<br/>')||'Belum ada komposisi'}</div></div>`).join('')||'Belum ada komposisi';}
g('toggleForm').onclick=()=>{g('formWrap').style.display=g('formWrap').style.display==='none'?'block':'none';};g('save').onclick=async()=>{const eid=parseInt(g('editId').value||'0');const qty=parseFloat(g('qty').value||'0');if(qty<=0){alert('Qty wajib > 0');return;}const r=eid>0?await fetch('/api/supervisor/menu-recipes/'+eid,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({quantityNeeded:qty})}):await fetch('/api/supervisor/menu-recipes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({menuItemId:parseInt(g('menu').value||'0'),stockItemId:parseInt(g('ingredient').value||'0'),quantityNeeded:qty})});if(!r.ok){alert('Gagal simpan');return;}reset();loadRecipes();};g('reset').onclick=reset;loadOptions();loadRecipes();setInterval(loadRecipes,10000);});</script>}
