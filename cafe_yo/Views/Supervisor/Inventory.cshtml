@{ Layout = "~/Views/Shared/_LayoutAdmin.cshtml"; ViewData["Title"] = "Inventaris"; }
<style>*{box-sizing:border-box}.sv{background:#0b1220;color:#fff;border:1px solid #1f3351;border-radius:16px;padding:1rem}.top{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem}.btn{background:#f6d44d;color:#111;border:0;border-radius:10px;padding:.55rem .85rem;font-weight:700}.btn2{background:#13233a;color:#fff;border:1px solid #2c466d;border-radius:10px;padding:.5rem .75rem}.btn2.active{background:#f6d44d;color:#111;border-color:#f6d44d}.row{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-top:.8rem}.card{background:#0f1a2d;border:1px solid #233a5d;border-radius:12px;padding:.75rem;overflow:hidden}input,select,textarea{width:100%;background:#091525;color:#fff;border:1px solid #2f4b74;border-radius:10px;padding:.5rem}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:.45rem}.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.45rem}.list{max-height:34vh;overflow:auto}.item{padding:.4rem 0;border-bottom:1px solid #223754;color:#fff}.muted{color:#fff}.act{display:flex;gap:.35rem;flex-wrap:wrap}h1,h2,h3,p,div,span,label,strong{color:#fff}@@media(max-width:960px){.row{grid-template-columns:1fr}.grid3{grid-template-columns:1fr}}</style>
<section class='sv'><div class='top'><h1 style='margin:0'>Inventaris, Rusak/Hilang, Expired</h1><div><button class='btn2' onclick="location.href='/Supervisor'">Kembali</button> <button class='btn2' id='toggleInv'>Tambah Inventaris</button> <button class='btn2' id='toggleDmg'>Catat Rusak/Hilang</button> <button class='btn2' id='toggleExp'>Catat Basi/Expired</button></div></div><div class='row'><div class='card'><div id='invWrap' style='display:none'><h3 id='invTitle' style='margin:.1rem 0 .5rem'>Tambah Inventaris</h3><input type='hidden' id='invId' value='0'><div class='grid2'><input id='invName' placeholder='Nama barang'><input id='invCategory' placeholder='Kategori'></div><div class='grid3' style='margin-top:.45rem'><input id='invTotal' type='number' placeholder='Total'><input id='invGood' type='number' placeholder='Baik'><input id='invUnit' placeholder='Unit'></div><div class='grid2' style='margin-top:.45rem'><input id='invBroken' type='number' placeholder='Rusak'><input id='invMissing' type='number' placeholder='Hilang'></div><textarea id='invNotes' rows='2' placeholder='Catatan' style='margin-top:.45rem'></textarea><div class='act' style='margin-top:.55rem'><button class='btn' id='invSave'>Simpan</button><button class='btn2' id='invReset'>Reset</button></div></div><h3 style='margin:.8rem 0 .5rem'>Daftar Inventaris</h3><div id='invList' class='list muted'>Memuat...</div></div><div class='card'><div id='dmgWrap' style='display:none'><h3 style='margin:.1rem 0 .5rem'>Catat Rusak/Hilang</h3><div class='muted' id='dmgTarget'>Pilih barang dari daftar inventaris.</div><div class='grid3' style='margin-top:.45rem'><input id='dmgQty' type='number' placeholder='Jumlah'><select id='dmgType'><option value='rusak'>Rusak</option><option value='hilang'>Hilang</option></select><select id='dmgStatus'><option value='dicatat'>Dicatat</option><option value='diganti'>Diganti</option><option value='selesai'>Selesai</option></select></div><input id='dmgReason' placeholder='Alasan' style='margin-top:.45rem'><textarea id='dmgNotes' rows='2' placeholder='Catatan' style='margin-top:.45rem'></textarea><button class='btn' id='dmgSave' style='margin-top:.55rem'>Simpan Catatan</button></div><div id='expWrap' style='display:none;margin-top:.8rem'><h3 style='margin:.1rem 0 .5rem'>Catat Bahan Basi / Expired</h3><div class='grid2'><select id='expStock'></select><input id='expQty' type='number' step='0.001' placeholder='Jumlah dibuang'></div><div class='grid2' style='margin-top:.45rem'><input id='expReason' placeholder='Alasan'><input id='expDate' type='date'></div><textarea id='expNotes' rows='2' placeholder='Catatan' style='margin-top:.45rem'></textarea><button class='btn' id='expSave' style='margin-top:.55rem'>Simpan Expired</button></div><h3 style='margin:.8rem 0 .5rem'>Log Rusak/Hilang</h3><div id='dmgList' class='list muted'>Memuat...</div><h3 style='margin:.8rem 0 .5rem'>Log Expired</h3><div id='expList' class='list muted'>Memuat...</div></div></div></section>
@section Scripts{<script>document.addEventListener('DOMContentLoaded',()=>{const g=id=>document.getElementById(id),esc=s=>String(s??'').replaceAll('<','&lt;');let invRows=[],selectedInvId=0;const panelButtons=['toggleInv','toggleDmg','toggleExp'];const setActive=(id)=>{panelButtons.forEach(x=>g(x).classList.toggle('active',x===id));};const showOnly=(wrapId,btnId)=>{['invWrap','dmgWrap','expWrap'].forEach(x=>g(x).style.display=(x===wrapId?'block':'none'));setActive(btnId);};const resetInv=()=>{g('invId').value='0';g('invTitle').textContent='Tambah Inventaris';['invName','invCategory','invTotal','invGood','invBroken','invMissing','invNotes'].forEach(x=>g(x).value='');g('invUnit').value='pcs';};window.pickInv=id=>{const x=invRows.find(v=>v.inventoryItemId===id);if(!x)return;selectedInvId=id;g('dmgTarget').textContent='Target: #'+id+' '+(x.name||'-');g('invId').value=id;g('invTitle').textContent='Edit Inventaris #'+id;g('invName').value=x.name||'';g('invCategory').value=x.category||'';g('invTotal').value=x.totalStock||0;g('invGood').value=x.goodStock||0;g('invBroken').value=x.brokenStock||0;g('invMissing').value=x.missingStock||0;g('invUnit').value=x.unit||'pcs';g('invNotes').value=x.notes||'';showOnly('invWrap','toggleInv');};async function loadIngredients(){const r=await fetch('/api/supervisor/ingredients/all',{cache:'no-store'});if(!r.ok)return;const d=await r.json();const rows=(Array.isArray(d?.ingredients)?d.ingredients:[]).filter(x=>x.isActive);g('expStock').innerHTML=rows.map(x=>`<option value='${x.stockItemId}'>${esc(x.name)} (${esc(x.unit)})</option>`).join('');}async function loadInventory(){const r=await fetch('/api/supervisor/inventory/items',{cache:'no-store'});if(!r.ok)return;const d=await r.json();invRows=Array.isArray(d?.items)?d.items:[];g('invList').innerHTML=invRows.map(x=>`<div class='item'>#${x.inventoryItemId} <strong>${esc(x.name)}</strong> - total ${x.totalStock} ${esc(x.unit)} | baik ${x.goodStock} | rusak ${x.brokenStock} | hilang ${x.missingStock}<div class='act'><button class='btn2' onclick='pickInv(${x.inventoryItemId})'>Pilih/Edit</button></div></div>`).join('')||'Belum ada data.';}async function loadDamages(){const r=await fetch('/api/supervisor/inventory/damages',{cache:'no-store'});if(!r.ok)return;const d=await r.json();const rows=Array.isArray(d?.damages)?d.damages:[];g('dmgList').innerHTML=rows.slice(0,80).map(x=>`<div class='item'>${x.logDate} - ${esc(x.itemName)}: ${x.quantity} (${x.damageType}) [${x.status}]</div>`).join('')||'Belum ada catatan.';}async function loadExpired(){const r=await fetch('/api/supervisor/expired-logs',{cache:'no-store'});if(!r.ok)return;const d=await r.json();const rows=Array.isArray(d?.expiredLogs)?d.expiredLogs:[];g('expList').innerHTML=rows.slice(0,80).map(x=>`<div class='item'>${x.expiredDate} - ${esc(x.stockName)}: buang ${x.quantityDisposed}</div>`).join('')||'Belum ada catatan.';}g('toggleInv').onclick=()=>showOnly('invWrap','toggleInv');g('toggleDmg').onclick=()=>showOnly('dmgWrap','toggleDmg');g('toggleExp').onclick=()=>showOnly('expWrap','toggleExp');g('invSave').onclick=async()=>{const id=parseInt(g('invId').value||'0');const payload={name:g('invName').value,category:g('invCategory').value,totalStock:parseInt(g('invTotal').value||'0'),goodStock:parseInt(g('invGood').value||'0'),brokenStock:parseInt(g('invBroken').value||'0'),missingStock:parseInt(g('invMissing').value||'0'),unit:g('invUnit').value,notes:g('invNotes').value,isActive:true};const r=await fetch(id>0?('/api/supervisor/inventory/items/'+id):'/api/supervisor/inventory/items',{method:id>0?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!r.ok){alert('Gagal simpan inventaris');return;}resetInv();loadInventory();};g('invReset').onclick=resetInv;g('dmgSave').onclick=async()=>{if(selectedInvId<=0){alert('Pilih inventaris dulu');return;}const payload={inventoryItemId:selectedInvId,quantity:parseInt(g('dmgQty').value||'0'),damageType:g('dmgType').value,status:g('dmgStatus').value,reason:g('dmgReason').value,notes:g('dmgNotes').value};const r=await fetch('/api/supervisor/inventory/damages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!r.ok){alert('Gagal simpan');return;}['dmgQty','dmgReason','dmgNotes'].forEach(x=>g(x).value='');loadInventory();loadDamages();};g('expSave').onclick=async()=>{const payload={stockItemId:parseInt(g('expStock').value||'0'),quantityDisposed:parseFloat(g('expQty').value||'0'),expiredDate:g('expDate').value||null,reason:g('expReason').value,notes:g('expNotes').value};const r=await fetch('/api/supervisor/expired-logs',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!r.ok){alert('Gagal simpan');return;}['expQty','expReason','expNotes'].forEach(x=>g(x).value='');loadExpired();};resetInv();showOnly('invWrap','toggleInv');loadIngredients();loadInventory();loadDamages();loadExpired();setInterval(()=>{loadInventory();loadDamages();loadExpired();},10000);});</script>}
