@model cafe_yo.Models.OwnerDashboardVm
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Owner Reports";
    var id = new System.Globalization.CultureInfo("id-ID");
    string Money(decimal v) => v.ToString("C0", id);
    var range = Model.ReportRange;
}

<style>
    .r-wrap{color:#e9edf6}.r-head{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;align-items:flex-end}
    .r-title{font-size:1.8rem;font-weight:800;margin:0}.r-sub{margin:.2rem 0 0;color:#99a3b8}
    .r-tabs{display:flex;gap:.45rem;flex-wrap:wrap;margin:.75rem 0}
    .r-tab{padding:.45rem .75rem;border-radius:10px;border:1px solid #2d3d5f;background:#111a2d;color:#b6c8ea;text-decoration:none;font-weight:700}
    .r-tab.active{background:linear-gradient(160deg,#1f355f,#183058);color:#eef5ff;border-color:#4a6aa1}
    .r-chip{padding:.35rem .65rem;border-radius:999px;background:#13213b;border:1px solid #2b3f64;color:#9ec5ff;text-decoration:none}
    .r-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-top:.9rem}
    .r-card{background:linear-gradient(160deg,#111729,#0b1020);border:1px solid #27344f;border-radius:14px;padding:1rem}
    .r-row{display:flex;justify-content:space-between;border:1px solid #27344f;padding:.5rem .65rem;border-radius:10px;background:#0d1426}
    .r-table th,.r-table td{border-bottom:1px solid #2a3855}
    @@media(max-width:980px){.r-grid{grid-template-columns:1fr}}
</style>

<section class="r-wrap">
    <div class="r-head">
        <div>
            <h1 class="r-title">Owner Reports</h1>
            <p class="r-sub">Laporan detail transaksi, kategori, dan produk.</p>
        </div>
    </div>

    <div class="r-tabs">
        <a class="r-tab" href="/Owner?range=@range">Dashboard</a>
        <a class="r-tab active" href="/Owner/Reports?range=@range">Reports</a>
        <a class="r-tab" href="/Owner/Analytics?range=@range">Analytics</a>
    </div>

    <div class="r-head">
        <div class="d-flex gap-2">
            <a class="r-chip @(range=="daily"?"fw-bold":"")" href="/Owner/Reports?range=daily">Harian</a>
            <a class="r-chip @(range=="weekly"?"fw-bold":"")" href="/Owner/Reports?range=weekly">Mingguan</a>
            <a class="r-chip @(range=="monthly"?"fw-bold":"")" href="/Owner/Reports?range=monthly">Bulanan</a>
            <a class="r-chip" href="/Owner/Export?range=@range">Export CSV</a>
            <a class="r-chip" href="javascript:window.print()">Export PDF</a>
        </div>
    </div>

    <div class="r-grid">
        <div class="r-card">
            <h2 class="h6 mb-3">Ringkasan Keuangan</h2>
            <div class="d-grid gap-2 mb-3">
                <div class="r-row"><span>Pemasukan Hari Ini</span><strong>@Money(Model.TodayRevenue)</strong></div>
                <div class="r-row"><span>Pemasukan Minggu Ini</span><strong>@Money(Model.WeekRevenue)</strong></div>
                <div class="r-row"><span>Pemasukan Bulan Ini</span><strong>@Money(Model.MonthRevenue)</strong></div>
                <div class="r-row"><span>Pengeluaran Bulan Ini</span><strong>@Money(Model.ExpensesMonth)</strong></div>
                <div class="r-row"><span>Profit Estimasi (@range)</span><strong>@Money(Model.EstimatedProfit)</strong></div>
            </div>
            <h2 class="h6 mb-3">Omzet per Kategori</h2>
            <div class="d-grid gap-2">
                @foreach (var c in Model.CategoryRevenue)
                {
                    <div class="r-row"><span>@c.Category</span><strong>@Money(c.Revenue)</strong></div>
                }
            </div>
        </div>
        <div class="r-card">
            <h2 class="h6 mb-3">Produk Terlaris</h2>
            <div class="d-grid gap-2">
                @foreach (var p in Model.TopProducts)
                {
                    <div class="r-row"><span>@p.Name</span><strong>@p.Qty qty</strong></div>
                }
            </div>
            <h2 class="h6 my-3">Menu Kurang Laku</h2>
            <div class="d-grid gap-2">
                @if (Model.LowProducts.Count == 0)
                {
                    <div class="r-row"><span>-</span><strong>0</strong></div>
                }
                else
                {
                    foreach (var p in Model.LowProducts)
                    {
                        <div class="r-row"><span>@p.Name</span><strong>@p.Qty qty</strong></div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="r-card mt-2">
        <h2 class="h6 mb-3">Transaksi Qualified Terbaru (Selesai + Lunas)</h2>
        <div class="table-responsive">
            <table class="table table-dark table-sm r-table mb-0">
                <thead><tr><th>Order</th><th>Meja</th><th>Waktu</th><th class="text-end">Total</th><th>Status</th></tr></thead>
                <tbody>
                @if (Model.RecentTransactions.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-white-50">Belum ada transaksi.</td></tr>
                }
                else
                {
                    foreach (var t in Model.RecentTransactions)
                    {
                        <tr>
                            <td>#@t.OrderId</td>
                            <td>@t.Table</td>
                            <td>@t.Date.ToString("dd MMM yyyy HH:mm", id)</td>
                            <td class="text-end">@Money(t.Total)</td>
                            <td>@t.Status</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
