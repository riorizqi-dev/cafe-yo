@model List<cafe_yo.Models.StockItem>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Stock Items";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Stock Items</h1>
    <a class="btn btn-primary btn-sm" href="/Admin/StockItems/Create">Add Stock Item</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Type</th>
                <th>Quantity</th>
                <th>Min Qty</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No stock items.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.StockItemId</td>
                    <td>@(string.IsNullOrWhiteSpace(item.Name) ? "-" : item.Name)</td>
                    <td>@(string.IsNullOrWhiteSpace(item.Type) ? "-" : item.Type)</td>
                    <td>@(item.Quantity.HasValue ? item.Quantity.Value.ToString() : "-")</td>
                    <td>@(item.MinQuantity.HasValue ? item.MinQuantity.Value.ToString() : "-")</td>
                    <td class="text-end">
                        <a class="btn btn-outline-secondary btn-sm" href="/Admin/StockItems/@item.StockItemId">Details</a>
                        <a class="btn btn-outline-primary btn-sm" href="/Admin/StockItems/Edit/@item.StockItemId">Edit</a>
                        <a class="btn btn-outline-danger btn-sm" href="/Admin/StockItems/Delete/@item.StockItemId">Delete</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
