@model cafe_yo.Models.StockItem
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Delete Stock Item";
}

<h1 class="h4 mb-3">Delete Stock Item</h1>

<div class="alert alert-warning">Are you sure you want to delete this stock item?</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Name) ? Model.Name : "-")</dd>

    <dt class="col-sm-3">Type</dt>
    <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Type) ? Model.Type : "-")</dd>
</dl>

<form method="post" action="/Admin/StockItems/Delete/@Model.StockItemId">
    @Html.AntiForgeryToken()
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/Admin/StockItems">Batal</a>
        <button class="btn btn-danger" type="submit">Delete</button>
    </div>
</form>
