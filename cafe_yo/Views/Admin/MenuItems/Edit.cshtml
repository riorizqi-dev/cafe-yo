@model cafe_yo.Models.MenuItem
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Edit Menu Item";
}

<h1 class="h4 mb-3">Edit Menu Item</h1>

<form method="post" action="/Admin/MenuItems/Edit/@Model.MenuItemId" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="MenuItemId" value="@Model.MenuItemId" />
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" name="Name" value="@Model.Name" />
        @Html.ValidationMessage("Name", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <label class="form-label">Category</label>
        <input class="form-control" name="Category" value="@Model.Category" />
    </div>
    <div class="mb-3">
        <label class="form-label">Image URL (optional)</label>
        <input class="form-control" name="ImageUrl" value="@Model.ImageUrl" placeholder="/images/menu/menu-baru.jpg atau https://..." />
        @Html.ValidationMessage("ImageUrl", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <label class="form-label">Upload New Image (optional, max 2MB)</label>
        <input class="form-control" name="imageFile" type="file" accept=".jpg,.jpeg,.png,.webp" />
        <div class="form-text text-white-50">Jika upload diisi, gambar lama akan diganti.</div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <div class="mb-3">
            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-thumbnail" style="max-width: 180px; border-radius: 10px;"
                 onerror="this.onerror=null;this.src='/images/menu/nasi-goreng.jpg';" />
        </div>
    }
    <div class="mb-3">
        <label class="form-label">Price</label>
        <input class="form-control" name="Price" type="number" step="0.01" value="@Model.Price" />
        @Html.ValidationMessage("Price", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <label class="form-label">Stock</label>
        <input class="form-control" name="Stock" type="number" min="0" value="@Model.Stock" />
        @Html.ValidationMessage("Stock", new { @class = "text-danger" })
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="IsAvailable" value="true" @(Model.IsAvailable == true ? "checked" : "") />
        <label class="form-check-label">Available</label>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/Admin/MenuItems">Batal</a>
        <button class="btn btn-primary" type="submit">Save Changes</button>
    </div>
</form>
