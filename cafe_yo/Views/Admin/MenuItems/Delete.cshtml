@model cafe_yo.Models.MenuItem
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Delete Menu Item";
}

<h1 class="h4 mb-3">Delete Menu Item</h1>

<div class="alert alert-warning">Are you sure you want to delete this menu item?</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Category) ? Model.Category : "-")</dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@Model.Price.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</dd>

    <dt class="col-sm-3">Stock</dt>
    <dd class="col-sm-9">@Model.Stock</dd>
</dl>

<form method="post" action="/Admin/MenuItems/Delete/@Model.MenuItemId">
    @Html.AntiForgeryToken()
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/Admin/MenuItems">Batal</a>
        <button class="btn btn-danger" type="submit">Delete</button>
    </div>
</form>
