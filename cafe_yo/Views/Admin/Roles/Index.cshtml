@model cafe_yo.Models.AdminRoleCreateVM
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Roles</h1>
    <div class="d-flex gap-2">
        <form method="post" action="/Admin/Roles/ResetAdminOnly" onsubmit="return confirm('Reset ke mode admin-only? Role selain Admin akan dihapus.');">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-warning btn-sm" type="submit">Reset Admin Only</button>
        </form>
        <a class="btn btn-outline-secondary btn-sm" href="/Admin/Users">Kembali ke Pengguna</a>
    </div>
</div>

@if (TempData["RoleSuccess"] != null)
{
    <div class="alert alert-success">@TempData["RoleSuccess"]</div>
}

<div class="card mb-3">
    <div class="card-header">Create Role</div>
    <div class="card-body">
        <form method="post" action="/Admin/Roles/Create">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Role Name</label>
                <input class="form-control" name="Name" value="@Model.Name" />
                @Html.ValidationMessage("Name", new { @class = "text-danger" })
            </div>
            @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })
            <button class="btn btn-primary" type="submit">Create</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">Existing Roles</div>
    <div class="card-body p-0">
        <ul class="list-group list-group-flush">
            @if (Model.ExistingRoles.Count == 0)
            {
                <li class="list-group-item text-muted">No roles.</li>
            }
            else
            {
                foreach (var role in Model.ExistingRoles)
                {
                    <li class="list-group-item">@role</li>
                }
            }
        </ul>
    </div>
</div>
