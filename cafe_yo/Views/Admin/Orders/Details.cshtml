@model cafe_yo.Models.AdminOrderEditVM
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Detail Pesanan";
}

<h1 class="h4 mb-3">Detail Pesanan</h1>

<dl class="row">
    <dt class="col-sm-3">ID Pesanan</dt>
    <dd class="col-sm-9">@Model.OrderId</dd>

    <dt class="col-sm-3">Meja</dt>
    <dd class="col-sm-9">@((Model.TableNumber.HasValue) ? $"#{Model.TableNumber.Value}" : "-")</dd>

    <dt class="col-sm-3">Tanggal Pesanan</dt>
    <dd class="col-sm-9">@Model.OrderDate?.ToString("yyyy-MM-dd HH:mm")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Status) ? Model.Status : "-")</dd>

    <dt class="col-sm-3">Total</dt>
    <dd class="col-sm-9">
        @((Model.Total.HasValue) ? Model.Total.Value.ToString("C0", new System.Globalization.CultureInfo("id-ID")) : "-")
    </dd>
</dl>

<h2 class="h6 mt-4">Item Pesanan</h2>
<div class="table-responsive">
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th>Item</th>
                <th class="text-center">Qty</th>
                <th class="text-end">Harga</th>
                <th class="text-end">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">Belum ada item.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    var subtotal = item.UnitPrice * item.Quantity;
                    <tr>
                        <td>
                            <div>@item.Name</div>
                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <div class="small text-muted">Catatan: @item.Notes</div>
                            }
                        </td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">@item.UnitPrice.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</td>
                        <td class="text-end">@subtotal.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="d-flex gap-2">
    <a class="btn btn-outline-secondary" href="/Admin/Orders">Kembali</a>
    <a class="btn btn-outline-primary" href="/Admin/Orders/Edit/@Model.OrderId">Ubah Status</a>
</div>
