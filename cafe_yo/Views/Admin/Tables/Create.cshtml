@model cafe_yo.Models.CafeTable
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Create Table";
}

<h1 class="h4 mb-3">Create Table</h1>

<form method="post" action="/Admin/Tables/Create">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Table Number</label>
        <input class="form-control" name="TableNumber" type="number" value="@Model.TableNumber" />
        @Html.ValidationMessage("TableNumber", new { @class = "text-danger" })
    </div>
    <div class="mb-3">
        <label class="form-label">Status</label>
        <input class="form-control" name="Status" value="@Model.Status" />
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/Admin/Tables">Batal</a>
        <button class="btn btn-primary" type="submit">Save</button>
    </div>
</form>
