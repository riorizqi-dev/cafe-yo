@model List<cafe_yo.Models.CafeTable>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Tables";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Tables</h1>
    <a class="btn btn-primary btn-sm" href="/Admin/Tables/Create">Add Table</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Table Number</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-center text-muted">No tables.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.TableId</td>
                    <td>@item.TableNumber</td>
                    <td>@(string.IsNullOrWhiteSpace(item.Status) ? "-" : item.Status)</td>
                    <td class="text-end">
                        <a class="btn btn-outline-secondary btn-sm" href="/Admin/Tables/@item.TableId">Details</a>
                        <a class="btn btn-outline-primary btn-sm" href="/Admin/Tables/Edit/@item.TableId">Edit</a>
                        <a class="btn btn-outline-danger btn-sm" href="/Admin/Tables/Delete/@item.TableId">Delete</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
