@model List<cafe_yo.Models.MenuCategory>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Category";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Kategori Menu</h1>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<div class="kitchen-column mb-3">
    <form method="post" action="/Admin/Category/Create" class="row g-2">
        @Html.AntiForgeryToken()
        <div class="col-md-8">
            <input class="form-control auth-modal-input" name="name" placeholder="Nama kategori baru" />
        </div>
        <div class="col-md-4 d-grid">
            <button class="btn btn-gold" type="submit">Tambah Kategori</button>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-dark table-striped align-middle">
        <thead>
            <tr>
                <th>Nama</th>
                <th>Status</th>
                <th class="text-end">Aksi</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="3" class="text-center text-white-50">Belum ada kategori.</td></tr>
            }
            else
            {
                foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@(c.IsActive ? "Aktif" : "Nonaktif")</td>
                        <td class="text-end">
                            <form method="post" action="/Admin/Category/@c.CategoryId/Toggle" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-light btn-sm" type="submit">Toggle</button>
                            </form>
                            <form method="post" action="/Admin/Category/@c.CategoryId/Delete" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
