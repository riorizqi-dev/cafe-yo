@model cafe_yo.Models.AdminDashboardVM
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Admin Dashboard</h1>
        <div class="text-muted">Ringkasan data utama Cafe Yo.</div>
    </div>
    <div>
        <a class="btn btn-sm btn-outline-light" href="/" role="button">Buka Situs</a>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-warning">@ViewBag.Error</div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted">Total Menu</div>
                <div class="display-6">@Model.TotalMenu</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted">Total Meja</div>
                <div class="display-6">@Model.TotalTables</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted">Total Order</div>
                <div class="display-6">@Model.TotalOrders</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted">Low Stock</div>
                <div class="display-6">@Model.LowStockCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted">Order Hari Ini</div>
                <div class="display-6">@((Model.TodayOrders.HasValue) ? Model.TodayOrders.Value.ToString() : "-")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted">Revenue Hari Ini</div>
                <div class="display-6">
                    @((Model.TodayRevenue.HasValue)
                        ? Model.TodayRevenue.Value.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
                        : "-")
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <div class="fw-semibold">Order Terbaru</div>
        <a class="btn btn-sm btn-outline-primary" href="/Admin/Orders">Lihat Semua</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 110px;">ID Pesanan</th>
                        <th>Meja</th>
                        <th>Total</th>
                        <th>Tanggal</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.RecentOrders != null && Model.RecentOrders.Count > 0)
                {
                    foreach (var order in Model.RecentOrders)
                    {
                        <tr>
                            <td>@(order.OrderId?.ToString() ?? "-")</td>
                            <td>@(string.IsNullOrWhiteSpace(order.TableNumber) ? "-" : order.TableNumber)</td>
                            <td>
                                @((order.TotalAmount.HasValue)
                                    ? order.TotalAmount.Value.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
                                    : "-")
                            </td>
                            <td>@(order.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            <td>@(string.IsNullOrWhiteSpace(order.Status) ? "-" : order.Status)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Belum ada order terbaru.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
