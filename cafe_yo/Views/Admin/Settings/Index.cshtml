@model Dictionary<string, string>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Settings";
    string tax = Model.ContainsKey("TaxPercent") ? Model["TaxPercent"] : "5";
    string service = Model.ContainsKey("ServiceChargePercent") ? Model["ServiceChargePercent"] : "5";
    string qris = Model.ContainsKey("QrisImageUrl") ? Model["QrisImageUrl"] : "";
}

<h1 class="h4 mb-3">System Settings</h1>

@if (ViewBag.Success != null)
{
    <div class="alert alert-success">@ViewBag.Success</div>
}

<div class="kitchen-column">
    <form method="post" action="/Admin/Settings">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label auth-modal-label">Pajak (%)</label>
            <input name="taxPercent" class="form-control auth-modal-input" value="@tax" />
        </div>
        <div class="mb-3">
            <label class="form-label auth-modal-label">Service Charge (%)</label>
            <input name="serviceChargePercent" class="form-control auth-modal-input" value="@service" />
        </div>
        <div class="mb-3">
            <label class="form-label auth-modal-label">QRIS Image URL</label>
            <input name="qrisImageUrl" class="form-control auth-modal-input" value="@qris" />
        </div>
        <button class="btn btn-gold" type="submit">Simpan</button>
    </form>
</div>
